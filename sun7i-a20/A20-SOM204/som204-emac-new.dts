/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "olimex,a20-olimex-som204-evb",
		     "olimex,a20-olimex-som204-evb-emmc";
	description = "Enable 100M EMAC2 (disable GMAC + disable CAN pins + CAN_CTRL high)";

	/* Disable GMAC */
	fragment@0 {
		target = <&gmac>;
		__overlay__ {
			status = "disabled";
		};
	};

	/* EMAC2 pinmux (includes PH20/PH21 => conflicts with CAN) */
	fragment@1 {
		target = <&pio>;
		__overlay__ {
			emac_pins_b: emac0@1 {
				pins = "PH8", "PH9", "PH10", "PH11",
				       "PH14", "PH15", "PH16", "PH17",
				       "PH18", "PH19", "PH20", "PH21",
				       "PH22", "PH23", "PH24", "PH25",
				       "PH26", "PH27";
				function = "emac";
			};

			/*
			 * CAN_CTRL on PA9 must be HIGH so the CAN driver/transceiver
			 * is disabled and doesn't fight the 100M PHY signals.
			 */
			can_ctrl_disable_hog: can-ctrl-disable-hog {
				gpio-hog;
				gpios = <0 9 GPIO_ACTIVE_HIGH>; /* PA9 */
				output-high;
				line-name = "can_ctrl_disable";
			};
		};
	};

	/* MDIO + PHY on EMAC2, PC18 reset line */
	fragment@2 {
		target = <&mdio>;
		__overlay__ {
			phy-supply = <&reg_vcc3v3>;
			reset-gpios = <&pio 2 18 GPIO_ACTIVE_LOW>; /* PC18 MEPHY-RST# */
			status = "okay";

			phy1: ethernet-phy@1 {
				reg = <1>;
			};
		};
	};

	/* Enable EMAC2 */
	fragment@3 {
		target = <&emac>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&emac_pins_b>;
			phy = <&phy1>;
			status = "okay";
		};
	};

	fragment@4 {
		target = <&emac_sram>;
		__overlay__ {
			status = "okay";
		};
	};

	/* Disable CAN controller so it releases PH20/PH21 */
	fragment@5 {
		target = <&can0>;
		__overlay__ {
			status = "disabled";
		};
	};
};
